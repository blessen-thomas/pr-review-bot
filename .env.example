# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Redis (for BullMQ queue) ---
REDIS_URL=redis://localhost:6379

# --- App ---
PORT=3000
# Skip diffs larger than this many changed lines (cost/runaway-loop guard)
MAX_DIFF_LINES=800
# Max number of PR reviews this bot will run per repo per day
MAX_REVIEWS_PER_REPO_PER_DAY=20
